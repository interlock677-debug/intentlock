# Application environment
APP_NAME=IntentLock
APP_ENV=development
DEBUG=true

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Database (use PostgreSQL in production)
DATABASE_URL=sqlite:///./intentlock.db
# DATABASE_URL=postgresql+psycopg2://intentlock:intentlock_secret@db:5432/intentlock

# JWT — replace with a cryptographically secure secret (min 32 chars)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password hashing
BCRYPT_ROUNDS=12

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
