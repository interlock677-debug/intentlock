# IntentLock v4.0 Configuration
# Copy to .env and adjust for your environment.

# --- Application ---
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
# SQLite (development)
DATABASE_URL=sqlite:///./intentlock.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+psycopg2://intentlock:password@db:5432/intentlock

# --- Security ---
# JWT_SECRET_KEY must be a cryptographically secure random value (min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=development-intentlock-secret-key-2026-abcdef
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_CLOCK_SKEW_SECONDS=30

# Ed25519 execution token key (optional; generated if not provided)
# EXECUTION_KEY_PATH=/path/to/execution_key.pem
EXECUTION_TOKEN_TTL_SECONDS=1

BCRYPT_ROUNDS=12

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Redis ---
# REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_INTENT_PER_MINUTE=60

# --- HITL ---
HITL_TTL_SECONDS=300

# --- Velocity tracking ---
VELOCITY_WINDOW_SECONDS=60
VELOCITY_MAX_REQUESTS=100
VELOCITY_MAX_CUMULATIVE_VALUE=10000
VELOCITY_MAX_CUMULATIVE_RISK=5
VELOCITY_MAX_SENSITIVE_OPERATIONS=10

# --- Webhooks ---
# WEBHOOK_HMAC_SECRET=change-me-to-a-secure-random-value
WEBHOOK_TIMEOUT_SECONDS=10